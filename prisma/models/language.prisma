enum LanguageType {
  NATIONAL
  REGIONAL
}

model Language {
  id         Int          @id @default(autoincrement()) @db.SmallInt
  code       String       @unique @db.VarChar(10)
  name       String       @db.VarChar(50)
  nativeName String?      @map("native_name") @db.VarChar(50)
  type       LanguageType @default(NATIONAL)

  isActive   Boolean @default(true) @map("is_active")
  isDefault  Boolean @default(false) @map("is_default")

  supportsVoiceCalls Boolean @default(true) @map("supports_voice_calls")
  supportsVideoCalls Boolean @default(true) @map("supports_video_calls")
  supportsOnboarding Boolean @default(true) @map("supports_onboarding")
  supportsInAppChat  Boolean @default(true) @map("supports_in_app_chat")

  createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  admins        Admin[]
  userLanguages UserLanguage[]
  interestCategories InterestCategoryLanguage[]
  
  @@map("languages")
}