// ============================================================================
// CORE USER MODULE
// ============================================================================

model User {
  id                    BigInt             @id @default(autoincrement())
  publicId              String             @unique @default(uuid()) @map("public_id") @db.Uuid
  displayCode           String             @unique @map("display_code") @db.VarChar(20)
  fullName              String             @map("full_name") @db.VarChar(150)
  email                 String?            @unique @db.Citext
  mobileCountryCode     String             @map("mobile_country_code") @db.VarChar(5)
  mobileNumber          String             @map("mobile_number") @db.VarChar(15)
  gender                Gender?
  dateOfBirth           DateTime?          @map("date_of_birth") @db.Date
  city                  String?            @db.VarChar(100)
  state                 String?            @db.VarChar(100)
  country               String?            @db.VarChar(100)
  avatarUrl             String?            @map("avatar_url")
  status                UserStatus         @default(active)
  verificationStatus    VerificationStatus @default(unverified) @map("verification_status")
  currentSubscriptionId Int?               @map("current_subscription_id") @db.SmallInt
  totalCallsCount       Int                @default(0) @map("total_calls_count")
  registeredAt          DateTime           @default(now()) @map("registered_at")
  lastLoginAt           DateTime?          @map("last_login_at")
  lastActiveAt          DateTime?          @map("last_active_at")
  createdById           BigInt?            @map("created_by")
  updatedById           BigInt?            @map("updated_by")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  deletedAt             DateTime?          @map("deleted_at")

  currentSubscription SubscriptionPlan? @relation(fields: [currentSubscriptionId], references: [id])
  createdBy           Admin?            @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy           Admin?            @relation("UserUpdatedBy", fields: [updatedById], references: [id])

  languages     UserLanguage[]
  subscriptions UserSubscription[]
  statusHistory UserStatusHistory[]
  adminNotes    AdminNote[]
  activityLogs  UserActivityLog[]
  wallet        UserWallet?

  @@unique([mobileCountryCode, mobileNumber], name: "uq_users_mobile")
  @@index([status])
  @@index([verificationStatus])
  @@index([currentSubscriptionId])
  @@index([registeredAt])
  @@map("users")
}

model UserLanguage {
  userId     BigInt   @map("user_id")
  languageId Int      @map("language_id") @db.SmallInt
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id])

  @@id([userId, languageId])
  @@map("user_languages")
}

model UserSubscription {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  planId      Int       @map("plan_id") @db.SmallInt
  startedAt   DateTime  @default(now()) @map("started_at")
  expiresAt   DateTime? @map("expires_at")
  isCurrent   Boolean   @default(true) @map("is_current")
  createdById BigInt?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  createdBy Admin?           @relation(fields: [createdById], references: [id])

  @@index([userId])
  @@map("user_subscriptions")
}

model UserStatusHistory {
  id             BigInt     @id @default(autoincrement())
  userId         BigInt     @map("user_id")
  previousStatus UserStatus @map("previous_status")
  newStatus      UserStatus @map("new_status")
  reason         String?
  changedById    BigInt?    @map("changed_by")
  createdAt      DateTime   @default(now()) @map("created_at")

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  changedBy Admin? @relation(fields: [changedById], references: [id])

  @@index([userId, createdAt])
  @@map("user_status_history")
}

model AdminNote {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  adminId   BigInt    @map("admin_id")
  note      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin Admin @relation(fields: [adminId], references: [id])

  @@index([userId, createdAt])
  @@map("admin_notes")
}

model ActivityType {
  id    Int    @id @default(autoincrement()) @db.SmallInt
  code  String @unique @db.VarChar(30)
  label String @db.VarChar(100)

  logs UserActivityLog[]

  @@map("activity_types")
}

model UserActivityLog {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  activityTypeId Int      @map("activity_type_id") @db.SmallInt
  ipAddress      String?  @map("ip_address") @db.Inet
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType ActivityType @relation(fields: [activityTypeId], references: [id])

  @@index([userId, createdAt])
  @@map("user_activity_log")
}

model UserWallet {
  userId    BigInt   @id @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  coins     BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_wallets")
}
